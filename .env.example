# Copy to .env next to docker-compose.yml and fill in.
API_KEYS=change-me
DEVICE_POOL_SIZE=3
HOST_PORT=8787

# --- WARP proxy pool (10 containers) ---
# Enable: docker compose --profile warp up -d
# Status: curl http://localhost:8787/proxy-status
#
# WARP_AGREE_TOS=yes
# PROXY_URLS=socks5://warp1:1080,socks5://warp2:1080,socks5://warp3:1080,socks5://warp4:1080,socks5://warp5:1080,socks5://warp6:1080,socks5://warp7:1080,socks5://warp8:1080,socks5://warp9:1080,socks5://warp10:1080
